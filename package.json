    "@vercel/speed-insights": "^1.3.1",
    "classnames": "^2.5.1",
    "copy-to-clipboard": "^3.3.3",
    "date-fns": "^4.4.0",
    "esbuild": "^0.27.7",
    "eslint-config-acme": "^3.1.0",
    "framer-motion": "^12.43.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "next": "^16.3.2",
    "next-mdx-remote-client": "^2.1.12",
    "next-seo": "^7.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-dom-confetti": "^0.2.0",
    "react-icons": "^5.7.0",
    "react-lite-youtube-embed": "^3.6.2",
    "react-live-runner": "^1.0.7",
    "reading-time": "^1.5.0",
