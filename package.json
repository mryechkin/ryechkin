    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "autoprefixer": "^10.5.4",
